# Build outputs - rebuilt inside the image, and copying host artifacts in would mix a host-built
# binary with a container-built one.
**/bin/
**/obj/
**/dist/
**/node_modules/
**/wwwroot/

# Secrets must never enter the image. Dhan credentials and the Telegram token are supplied as
# environment variables at runtime (see README) - appsettings.Local.json is for local runs only.
**/appsettings.Local.json
**/appsettings.*.local.json
**/*.pem
**/*.key
**/id_rsa*
.env
.env.*

# Data the server writes when it runs from its own folder on a developer's machine (caches, the scanner's files, a copy of
# the runner scripts with its node_modules) and the local-only ML / AI tooling - none of it belongs in an image.
**/scanner-runner-data/
**/dhan-cache/
**/order-flow/
**/historical-data/
**/expired-option-data/
**/scanner-log/
OptionAnalytics.Server/scanner-runner/
llm/
**/.venv/

# Runtime state, not source - see StrategyTriggerStore.
**/strategy-triggers.json

.git/
.github/
.vs/
.vscode/
.idea/
**/*.user
**/*.swp
