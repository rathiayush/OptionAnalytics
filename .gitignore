# .NET
bin/
obj/
*.user

# Node / Vite
node_modules/
dist/
*.local

# Local secrets - see README for the recommended way to set Dhan:ClientId/Dhan:AccessToken
# (environment variables) without committing them; these paths are ignored in case they're used
# anyway.
appsettings.Local.json
appsettings.*.local.json

# OS / editor
.vs/
.vscode/
.idea/
*.swp

# Saved strategy triggers are local runtime config (see StrategyTriggerStore), not source.
strategy-triggers.json
trigger-order-history.json

# DataProtection's own key ring (see Program.cs's Storage:DataProtectionKeysPath) - regenerated
# locally on first run when that setting isn't configured; committing it would both be pointless
# (docker-compose.yml points production at a persistent volume instead) and put real key material
# in source control.
dataprotection-keys/

# HistoricalSpotDataPrefetchHostedService's on-disk cache (see Storage:HistoricalDataPath) -
# regenerated locally the same way, and only ever meaningful on the machine that fetched it.
historical-data/

# ExpiredOptionDataPrefetchHostedService's own on-disk cache (see Storage:ExpiredOptionDataPath) -
# same reasoning, just for the rolling-option (CE/PE premium) side instead of spot.
expired-option-data/

# ScannerLogStore's CSVs (see Storage:ScannerLogPath) - the scanner's record, kept on the server.
scanner-log/
order-flow/
# DhanDataCache (Storage:DhanCachePath) - every past Dhan day, NSE and scrip-master files; up to 10 GB, re-fetchable.
dhan-cache/
# Other server data folders that default to the project folder when run locally.
/OptionAnalytics.Server/scanner-runner/
/OptionAnalytics.Server/preferences/
/OptionAnalytics.Server/paper-positions/
visitor-log/
geo/
# Every Telegram message sent (TelegramMessageLog) and the Telegram signals page's SIGN-IN to read the channel
# (TelegramChannelReader - a Telegram account's session: a secret, never committed).
telegram-log/
telegram-session/
live-time-exits.json

# Local deployment env (never commit)
.env
.env.*

# The client's build output. It is published straight from optionanalytics.client/dist by the
# csproj's BuildAndCopyClient target and is never copied into the source tree, so anything here
# other than .gitkeep is a leftover from a local build.
OptionAnalytics.Server/wwwroot/*
!OptionAnalytics.Server/wwwroot/.gitkeep

# The server-side scanner bundle (npm run build:runner) - published next to the server, never committed.
optionanalytics.client/dist-runner/

# Created next to the project when the server runs locally (Storage:* defaults).
/OptionAnalytics.Server/risk-settings.csv
/OptionAnalytics.Server/trade-settings.csv
/OptionAnalytics.Server/scanner-runner-data/

