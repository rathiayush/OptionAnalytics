<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- The folders the server WRITES to when it runs from this folder (every Storage:* path defaults to one next to the project; all gitignored):
       the ML models and their reports, the scanner's data, the order flow days, caches, preferences ... The Web SDK counts every .json under the
       project as a project file, so a model written while a build runs ("could not copy ... because it was not found") broke the build, and
       their sizes were copied into bin/. They are data, never part of the build. -->
  <ItemGroup>
    <Content Remove="scanner-runner-data/**;order-flow/**;historical-data/**;expired-option-data/**;scanner-log/**;dhan-cache/**;preferences/**;paper-positions/**;visitor-log/**;geo/**;dataprotection-keys/**" />
    <None Remove="scanner-runner-data/**;order-flow/**;historical-data/**;expired-option-data/**;scanner-log/**;dhan-cache/**;preferences/**;paper-positions/**;visitor-log/**;geo/**;dataprotection-keys/**" />
  </ItemGroup>

  <!-- Stamped fresh on every `dotnet publish` (Docker's own build stage runs one - see the
       Dockerfile), read back at runtime by GET /api/version. Answers "did my last redeploy
       actually pick up the latest code" directly, from the running process itself, rather than by
       inferring it from behavior - the recurring source of confusion this session kept running
       into (a merged fix that LOOKED unapplied because the server simply hadn't been redeployed
       yet). 'o' (round-trip) rather than a custom format string, purely to dodge escaping a
       literal ':'/'-' inside this already-double-quoted XML attribute. -->
  <ItemGroup>
    <AssemblyMetadata Include="BuildTimeUtc" Value="$([System.DateTime]::UtcNow.ToString('o'))" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MaxMind.Db" Version="5.2.0" />
    <PackageReference Include="Npgsql" Version="8.0.5" />
    <PackageReference Include="Polly.Core" Version="8.8.0" />
    <PackageReference Include="Polly.RateLimiting" Version="8.8.0" />
    <PackageReference Include="Skender.Stock.Indicators" Version="2.7.3" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="TrueData-DotNet" Version="1.4.7" />
    <PackageReference Include="WTelegramClient" Version="4.4.10" />
  </ItemGroup>

  <!-- appsettings.Local.json is a LOCAL credentials overlay (see Program.cs and .gitignore). It
       must never travel with a build: `dotnet run` reads it from the project directory via the
       content root, so nothing needs it in bin/ or in the publish output, and leaving it there
       carries real Dhan credentials into wherever the publish folder gets copied. Production
       supplies these as environment variables instead - see docker-compose.yml. -->
  <ItemGroup>
    <Content Update="appsettings.Local.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>
  <ItemGroup>
  </ItemGroup>

  <!-- Builds the React client and publishes its output as the app's wwwroot, so the production app
       is self-contained (UseStaticFiles + MapFallbackToFile in Program.cs serve it directly, no
       separate Node process needed). Dev keeps using the Vite dev server on its own port (see
       optionanalytics.client/vite.config.js) - this target never runs for a plain `dotnet build`/
       `dotnet run`, only for Publish.

       Hooked to ComputeFilesToPublish and adding ResolvedFileToPublish items, rather than copying
       into wwwroot/ BeforeTargets="Publish": wwwroot is globbed into Content at EVALUATION time,
       long before any target runs, so files written into it during the build are not in that list
       and a copy there is never actually published. That was the previous behaviour - the client
       built, its output landed in the source tree, and the published app shipped an empty wwwroot
       and served no UI at all. -->
  <Target Name="BuildAndCopyClient" BeforeTargets="ComputeFilesToPublish">
    <Exec Command="npm ci" WorkingDirectory="../optionanalytics.client" />
    <Exec Command="npm run build" WorkingDirectory="../optionanalytics.client" />
    <Exec Command="npm run build:runner" WorkingDirectory="../optionanalytics.client" />
    <ItemGroup>
      <ClientDist Include="../optionanalytics.client/dist/**" />
      <ResolvedFileToPublish Include="@(ClientDist)">
        <RelativePath>wwwroot/%(ClientDist.RecursiveDir)%(ClientDist.Filename)%(ClientDist.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <!-- The server-side scanner (ScannerRunnerHostedService runs it with Node): its bundle and the
           package.json of its one runtime dependency, installed by InstallScannerRunner below. -->
      <ResolvedFileToPublish Include="../optionanalytics.client/dist-runner/runner.mjs">
        <RelativePath>scanner-runner/runner.mjs</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="../optionanalytics.client/dist-runner/tune.mjs">
        <RelativePath>scanner-runner/tune.mjs</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <!-- The Signal backtest's background job (SignalBacktestJobService). -->
      <ResolvedFileToPublish Include="../optionanalytics.client/dist-runner/signal-backtest.mjs">
        <RelativePath>scanner-runner/signal-backtest.mjs</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <!-- The saved strategies' daily live scan (SignalLiveHostedService). -->
      <ResolvedFileToPublish Include="../optionanalytics.client/dist-runner/signal-live.mjs">
        <RelativePath>scanner-runner/signal-live.mjs</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="../optionanalytics.client/scanner-runner/package.json">
        <RelativePath>scanner-runner/package.json</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <!-- @microsoft/signalr (and its Node transports) for the published scanner runner. -->
  <Target Name="InstallScannerRunner" AfterTargets="Publish">
    <Exec Command="npm install --omit=dev --no-audit --no-fund" WorkingDirectory="$(PublishDir)scanner-runner" />
  </Target>

</Project>
